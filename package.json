{
  "name": "ember-and-iron",
  "version": "4.1.1",
  "private": true,
  "description": "A complete offline blacksmithing and arena incremental RPG",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:3d": "esbuild atelier/campaign-app.js --bundle --format=iife --minify --alias:three/addons=./atelier/vendor/three/examples/jsm --alias:three=./atelier/vendor/three/build/three.module.js --outfile=house-3d.js",
    "build": "npm run build:3d && python build_game.py",
    "serve": "python -m http.server 8777",
    "test:campaign": "node design/qa/house-campaign-probe.js --days=12 --respond --prepared --stop-at-crown --label=review"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "linkedom": "0.18.12",
    "prettier": "3.6.2"
  }
}
